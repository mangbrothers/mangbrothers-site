---
import logo from '../assets/logo-horizontal-cream.svg';
import { PHONE_DISPLAY, PHONE_TEL, EMAIL, PARTNER_URL } from '../data/services';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="inner">
    <div class="top">
      <img src={logo.src} alt="Mangiapane Brothers Lawn and Snow" class="logo" width="211" height="44" loading="lazy" />
      <div class="cols">
        <div class="col links">
          <a href="#services">Services</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
          <a href={PARTNER_URL}>Partner With Us</a>
        </div>
        <div class="col">
          <a class="tap phone" href={PHONE_TEL}>{PHONE_DISPLAY}</a>
          <a class="tap" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <span>Livonia and Westland, Michigan</span>
        </div>
      </div>
    </div>
    <div class="bottom">
      <span>© {year} Mangiapane Brothers Lawn and Snow LLC</span>
      <span class="legal"><a href="/privacy.html">Privacy</a><a href="/terms.html">Terms</a></span>
      <span>Reliable Service. Uncompromising Standards.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    background: var(--charcoal);
    color: var(--cream);
  }
  .inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
  }
  .logo {
    height: 44px;
    width: auto;
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    font-size: 15px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  a {
    color: var(--cream);
    text-decoration: none;
  }
  a:hover {
    color: var(--gold);
  }
  .phone {
    color: var(--gold);
    font-weight: 500;
  }
  .phone:hover {
    color: var(--cream);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--cream-15);
    font-size: 13px;
  }
  .legal {
    display: flex;
    gap: 20px;
  }
  .legal a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--cream-35);
  }

  @media (max-width: 760px) {
    .inner {
      padding: 40px 24px 120px;
      gap: 28px;
    }
    .links {
      display: none;
    }
    .tap {
      padding: 14px 0;
    }
    .col {
      gap: 0;
    }
    .col span {
      padding-top: 14px;
    }
    .legal a {
      padding: 12px 0;
    }
  }
</style>
