---
import Button from './Button.astro';
import { PHONE_DISPLAY, PHONE_TEL, PHONE_SMS } from '../data/services';
---
<div class="callbar" aria-label="Call or text Mangiapane Brothers" role="region">
  <Button href={PHONE_TEL} icon="phone" class="cb-call">{PHONE_DISPLAY}</Button>
  <Button href={PHONE_SMS} variant="ghost" class="cb-text">Text</Button>
</div>

<script>
  // Fallback for browsers without scroll-driven animations: reveal the bar after the hero.
  if (!CSS.supports('animation-timeline: scroll()')) {
    const bar = document.querySelector<HTMLElement>('.callbar');
    const hero = document.querySelector('.hero');
    if (bar && hero && 'IntersectionObserver' in window) {
      bar.classList.add('callbar--js');
      new IntersectionObserver(([e]) => bar.classList.toggle('callbar--shown', !e.isIntersecting), {
        rootMargin: '-80px 0px 0px 0px',
      }).observe(hero);
    }
  }
</script>

<style>
  .callbar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 10;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 12px));
    background: var(--charcoal);
    gap: 10px;
    border-top: 1px solid rgba(201, 161, 90, 0.4);
  }
  .callbar :global(.cb-call) {
    flex: 2;
    height: 52px;
    padding: 0 16px;
    background: rgba(201, 161, 90, 0.16);
  }
  .callbar :global(.cb-text) {
    flex: 1;
    height: 52px;
    padding: 0 16px;
  }

  @media (max-width: 760px) {
    .callbar {
      display: flex;
    }
    @supports (animation-timeline: scroll()) {
      .callbar {
        animation: bar-in linear both;
        animation-timeline: scroll(root);
        animation-range: 440px 520px;
      }
    }
    .callbar.callbar--js {
      transform: translateY(100%);
      opacity: 0;
      transition:
        transform 0.35s var(--ease-out),
        opacity 0.35s var(--ease-out);
    }
    .callbar.callbar--shown {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes bar-in {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .callbar,
    .callbar.callbar--js {
      animation: none;
      transition: none;
    }
  }
</style>
