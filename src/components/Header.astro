---
import logo from '../assets/logo-horizontal-cream.svg';
import PhoneIcon from './PhoneIcon.astro';
import { PHONE_DISPLAY, PHONE_TEL, PARTNER_URL } from '../data/services';

const links = [
  { href: '#services', label: 'Services' },
  { href: '#about', label: 'About' },
  { href: PARTNER_URL, label: 'Partner With Us' },
];
---
<header class="header">
  <a href="/" class="logo-link" aria-label="Mangiapane Brothers home">
    <img src={logo.src} alt="Mangiapane Brothers Lawn and Snow" class="logo" width="230" height="48" />
  </a>

  <nav class="nav" aria-label="Main">
    <a href="/" aria-current="page" class="nav-a">Home</a>
    {links.map((l) => <a href={l.href} class="nav-a">{l.label}</a>)}
    <span class="divider" aria-hidden="true"></span>
    <a href={PHONE_TEL} class="nav-phone"><PhoneIcon />{PHONE_DISPLAY}</a>
  </nav>

  <details class="menu">
    <summary aria-label="Menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg>
    </summary>
    <nav aria-label="Menu" class="menu-panel">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </details>
</header>

<script>
  // Close the phone menu after a link is tapped, or on outside tap / Escape.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: relative;
    z-index: 5;
    width: 100%;
    padding: 28px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .logo-link {
    display: flex;
  }
  .logo {
    height: 48px;
    width: auto;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    font-size: 16px;
  }
  .nav-a,
  .nav-phone {
    color: var(--cream);
    text-decoration: none;
  }
  .nav-a {
    position: relative;
    transition: color 0.2s;
  }
  .nav-a:hover {
    color: var(--cream);
  }
  .nav-a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }
  .nav-a:hover::after,
  .nav-a:focus-visible::after {
    transform: scaleX(1);
  }
  .nav-a[aria-current]::after {
    transform: scaleX(1);
    animation: draw 0.7s var(--ease-out) 0.9s backwards;
  }
  .nav:hover .nav-a[aria-current]:not(:hover)::after {
    transform: scaleX(0);
    transform-origin: right;
  }
  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .divider {
    width: 1px;
    height: 24px;
    background: var(--cream-35);
  }
  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.01em;
  }
  .nav-phone:hover {
    color: var(--gold);
  }

  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    width: 44px;
    height: 44px;
    border-radius: 4px;
    border: 1px solid var(--cream-60);
    color: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: 54px;
    z-index: 20;
    width: 220px;
    padding: 6px 20px 10px;
    border-radius: 12px;
    background: var(--oak);
    border: 1px solid var(--cream-16);
    box-shadow: 0 12px 32px rgba(26, 28, 24, 0.35);
    display: flex;
    flex-direction: column;
    font-size: 17px;
  }
  .menu-panel a {
    color: var(--cream);
    text-decoration: none;
    padding: 14px 4px;
  }
  .menu-panel a + a {
    border-top: 1px solid var(--cream-15);
  }

  @media (max-width: 760px) {
    .header {
      padding: 20px;
      flex-wrap: nowrap;
    }
    .logo {
      height: 40px;
    }
    .nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-a::after {
      animation: none;
    }
  }
</style>
