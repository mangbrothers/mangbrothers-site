---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '../styles/global.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import franklinLatin from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import heroSrc from '../assets/hero-backyard.jpg';
import { getHeroImages } from '../data/hero';

const hero = await getHeroImages();
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: heroSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Mangiapane Brothers Lawn and Snow LLC',
  url: 'https://mangbrothers.com',
  telephone: '+1-734-450-2400',
  email: 'admin@mangbrothers.com',
  foundingDate: '2019',
  slogan: 'Reliable Service. Uncompromising Standards.',
  areaServed: ['Livonia, MI', 'Westland, MI'],
  address: { '@type': 'PostalAddress', addressLocality: 'Livonia', addressRegion: 'MI', addressCountry: 'US' },
  image: ogUrl.href,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#023A1D" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mangiapane Brothers" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={hero.phone.src} media="(max-width: 760px)" fetchpriority="high" />
    <link rel="preload" as="image" href={hero.desk.src} media="(min-width: 761px) and (max-width: 1920px)" fetchpriority="high" />
    <link rel="preload" as="image" href={hero.wide.src} media="(min-width: 1921px)" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" href={franklinLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    {verification && <meta name="google-site-verification" content={verification} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
